{
	"id": "easypackx",
	"name": "easypackx",
	"description": "一个用来给 `uniapp/x` 构建自定义调试基座和发行包的离线打包插件。",
	"displayName": "EasyPackX",
	"version": "1.0.37",
	"publisher": "local",
	"engines": {
		"HBuilderX": ">=4.18.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension",
	"activationEvents": [
		"onCommand:extension.easypackx.packUnixAndroid",
		"onCommand:extension.easypackx.packUniAppXIos",
		"onCommand:extension.easypackx.packUniAndroid",
		"onCommand:extension.easypackx.openCombinedLog",
		"onCommand:extension.easypackx.openErrorLog",
		"onCommand:extension.easypackx.openReadme",
		"*"
	],
	"contributes": {
		"configuration": {
			"title": "EasyPackX",
			"properties": {
				"easypackx.sdkDownloadUrl": {
					"type": "string",
					"description": "Android离线打包SDK下载地址，<a href=\"https://doc.dcloud.net.cn/uni-app-x/native/download/android.html\">详情</a>",
					"default": "https://web-ext-storage.dcloud.net.cn/uni-app-x/sdk/Android/Android-uni-app-x-SDK@14694-5.07.zip"
				},
				"easypackx.uniappxNativeAndroid": {
					"type": "string",
					"description": "用来存放插件打包后的原生工程位置，方便开发者后面自行本地调试，请填写绝对路径。",
					"default": ""
				},
				"easypackx.iosSdkDownloadUrl": {
					"type": "string",
					"description": "iOS离线打包SDK下载地址，<a href=\"https://doc.dcloud.net.cn/uni-app-x/native/download/ios.html\">详情</a>",
					"default": "https://web-ext-storage.dcloud.net.cn/uni-app-x/sdk/iOS/UniAppX-iOS%405.07.zip"
				},
				"easypackx.uniappxNativeIos": {
					"type": "string",
					"description": "用来存放插件生成后的 iOS 原生工程位置，方便开发者后面使用 Xcode 调试或打包，请填写绝对路径。",
					"default": ""
				},
				"easypackx.iosBundleId": {
					"type": "string",
					"description": "iOS Bundle Identifier，自选证书或 Xcode 签名时使用。",
					"default": "cn.testapp.app"
				},
				"easypackx.sdkDir": {
					"type": "string",
					"description": "安卓SDK路径，如未安装请到 <a href=\"https://developer.android.google.cn/studio\">https://developer.android.google.cn/studio</a> 下载",
					"default": ""
				},
				"easypackx.javaHome": {
					"type": "string",
					"description": "JDK路径，如果安装了android studio，则为安装目录的jbr路径，（示例： %安装路径%\\jbr）",
					"default": ""
				},
				"easypackx.validateSDKVersion": {
					"type": "boolean",
					"description": "自动验证SDK版本，如果勾选，插件会自动根据校对编译器的版本和离线SDK的版本",
					"default": true
				},
				"easypackx.androidPackageName": {
					"type": "string",
					"description": "自选证书Android包名"
				},
				"easypackx.storePath": {
					"type": "string",
					"description": "自选证书证书库文件路径。<a href=\"https://ask.dcloud.net.cn/article/35777\">查看详情</a>"
				},
				"easypackx.storePassword": {
					"type": "string",
					"description": "自选证书证书库密码。对应安卓打包配置中的【storePassword】。<a href=\"https://ask.dcloud.net.cn/article/35777\">查看详情</a>"
				},
				"easypackx.keyAlias": {
					"type": "string",
					"description": "自选证书证书别名。对应安卓打包配置中的【keyAlias】。<a href=\"https://ask.dcloud.net.cn/article/35777\">查看详情</a>"
				},
				"easypackx.keyPassword": {
					"type": "string",
					"description": "自选证书证书密码。对应安卓打包配置中的【keyPassword】。<a href=\"https://ask.dcloud.net.cn/article/35777\">查看详情</a>"
				},
				"easypackx.projectCacheConfig": {
					"type": "boolean",
					"default": false,
					"description": "模块配置是否按照项目单独缓存，勾选后每次打包都会按照项目独立缓存"
				},
				"easypackx.autoPublishAppResource": {
					"type": "boolean",
					"default": false,
					"description": "插件自动发行本地资源，勾选后每次打包时都会自动调用cli的发行本地资源命令"
				},
				"easypackx.customSDKPath": {
					"type": "string",
					"description": "自定义项目SDK路径。选择自己下载解压后的SDK目录路径"
				}
			}
		},
		"commands": [
			{
				"command": "extension.easypackx.packUnixAndroid",
				"title": "打包uniapp x项目"
			},
			{
				"command": "extension.easypackx.packUniAppXIos",
				"title": "生成uniapp x iOS工程"
			},
			{
				"command": "extension.easypackx.packUniAndroid",
				"title": "打包uniapp 项目"
			},
			{
				"command": "extension.easypackx.openCombinedLog",
				"title": "查看运行日志"
			},
			{
				"command": "extension.easypackx.openErrorLog",
				"title": "查看错误日志"
			},
			{
				"command": "extension.easypackx.openReadme",
				"title": "查看文档"
			}
		],
		"keybindings": [
			{
				"command": "extension.easypackx.packUnixAndroid",
				"key": "Ctrl+Alt+X",
				"when": "editorTextFocus",
				"macosx": "Command+Alt+X"
			},
			{
				"command": "extension.easypackx.packUniAndroid",
				"key": "Ctrl+Alt+U",
				"when": "editorTextFocus",
				"macosx": "Command+Alt+U"
			}
		],
		"menus": {
			"editor/context": [
				{
					"id": "easypackx",
					"title": "EasyPackX",
					"group": "z_commands"
				},
				{
					"command": "extension.easypackx.packUnixAndroid",
					"group": "easypackx@1",
					"when": "editorTextFocus",
					"title": "打包uniapp x"
				},
				{
					"command": "extension.easypackx.packUniAppXIos",
					"group": "easypackx@2",
					"when": "editorTextFocus",
					"title": "生成uniapp x iOS工程"
				},
				{
					"command": "extension.easypackx.packUniAndroid",
					"group": "easypackx@3",
					"when": "editorTextFocus",
					"title": "打包uniapp"
				},
				{
					"command": "extension.easypackx.openCombinedLog",
					"group": "easypackx@4",
					"title": "查看运行日志"
				},
				{
					"command": "extension.easypackx.openErrorLog",
					"group": "easypackx@5",
					"title": "查看错误日志"
				},
				{
					"command": "extension.easypackx.openReadme",
					"group": "easypackx@6",
					"title": "查看文档"
				}
			],
			"menubar/run": [
				{
					"title": "EasyPackX",
					"id": "easypackx",
					"group": "easypackx"
				},
				{
					"command": "extension.easypackx.packUnixAndroid",
					"group": "easypackx@1",
					"title": "打包uniapp x"
				},
				{
					"command": "extension.easypackx.packUniAppXIos",
					"group": "easypackx@2",
					"title": "生成uniapp x iOS工程"
				},
				{
					"command": "extension.easypackx.packUniAndroid",
					"group": "easypackx@3",
					"title": "打包uniapp"
				}
			],
			"menubar/help": [
				{
					"title": "EasyPackX",
					"id": "easypackx",
					"group": "easypackx"
				},
				{
					"command": "extension.easypackx.openCombinedLog",
					"group": "easypackx@1",
					"title": "查看运行日志"
				},
				{
					"command": "extension.easypackx.openErrorLog",
					"group": "easypackx@2",
					"title": "查看错误日志"
				},
				{
					"command": "extension.easypackx.openReadme",
					"group": "easypackx@3",
					"title": "查看文档"
				}
			]
		},
		"viewsContainers": {
			"rightside": [
				{
					"id": "easypackxReadme",
					"title": "EasyPackX 使用文档"
				}
			]
		},
		"views": {
			"easypackxReadme": [
				{
					"id": "extension.easypackx.view.readme",
					"name": "ReadmeView"
				}
			]
		}
	},
	"extensionDependencies": [
		"plugin-manager"
	],
	"dependencies": {
		"cross-spawn": "^7.0.6",
		"markdown-it": "^14.1.0",
		"node-cache": "^5.1.2",
		"ws": "^8.17.1"
	}
}
